{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "format": {
          "enum": [
            "protein_fasta",
            "aligned_fasta",
            "stockholm",
            "a3m",
            "hmm",
            "json",
            "tsv"
          ],
          "title": "Format",
          "type": "string"
        },
        "storage": {
          "default": "bundled",
          "enum": [
            "bundled",
            "external"
          ],
          "title": "Storage",
          "type": "string"
        }
      },
      "required": [
        "path",
        "format"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "BiologicalTarget": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "organism": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organism"
        },
        "protein_accession": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protein Accession"
        },
        "protein_length": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protein Length"
        },
        "protein_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Sequence Ids",
          "type": "array"
        },
        "sequence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Sha256"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "model_accession": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Accession"
        }
      },
      "required": [
        "description"
      ],
      "title": "BiologicalTarget",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Reference Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "version",
        "sha256"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Reference Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "sequence",
            "sequence_set",
            "msa",
            "profile_hmm",
            "annotation_catalog"
          ],
          "title": "Resource Type",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "biological_target": {
          "$ref": "#/$defs/BiologicalTarget"
        },
        "derived_from": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "required": [
        "reference_id",
        "version",
        "sha256",
        "resource_type",
        "artifact",
        "source",
        "biological_target"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Locator",
          "type": "string"
        },
        "release": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "provider",
        "locator"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 1,
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "references"
  ],
  "title": "RegistryDocument",
  "type": "object"
}
